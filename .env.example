# =============================================================================
# OCOR - Our City, Our Responsibility (Frontend Local Environment Template)
# Copy to .env.local for local development. NEVER commit real secrets.
# =============================================================================

# FastAPI local backend URL (keep pointing to local backend during dev/testing)
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Centralized Brand Configuration (lib/brand.ts)
NEXT_PUBLIC_APP_NAME=OCOR
NEXT_PUBLIC_APP_TAGLINE=Our City, Our Responsibility
NEXT_PUBLIC_APP_LINE=We don't just solve problems. We build civilised citizens.
NEXT_PUBLIC_APP_SHORT=OCOR
NEXT_PUBLIC_APP_FULL_NAME=OCOR — Our City, Our Responsibility
NEXT_PUBLIC_APP_LOGO=/ocor-logo.jpg
NEXT_PUBLIC_APP_ICON=/icon.svg
NEXT_PUBLIC_CODE_PREFIX=OCOR
NEXT_PUBLIC_SUPPORT_EMAIL=hello@ocor.city
NEXT_PUBLIC_HASHTAGS=#OCOR,#OurCityOurResponsibility

# Local Ollama endpoint (do not deploy; local agent/audit tooling only)
OLLAMA_HOST=127.0.0.1:8081
