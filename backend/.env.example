# =============================================================================
# OCOR - Our City, Our Responsibility (Backend Environment Template)
# Copy to backend/.env for local development. NEVER commit real secrets.
# =============================================================================

# Database & Local Storage ("local" uses SQLite + disk uploads; zero prod calls)
DB_BACKEND=local
DATABASE_URL=sqlite:///./ocor.db
UPLOAD_DIR=./uploads

# Brand Metadata (backend/core/brand.py)
APP_NAME=OCOR
APP_TAGLINE=Our City, Our Responsibility
APP_LINE=We don't just solve problems. We build civilised citizens.
APP_SHORT=OCOR
APP_LOGO=/ocor-logo.jpg
APP_ICON=/icon.svg
APP_CODE_PREFIX=OCOR
SUPPORT_EMAIL=hello@ocor.city
APP_HASHTAGS=#OCOR,#OurCityOurResponsibility

# CORS (comma-separated allowed frontend origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local Ollama endpoint (port 8081 configured on this machine)
OLLAMA_HOST=127.0.0.1:8081

# App
DEBUG=false

# Optional Image Analysis (leave blank in local mode to use local fallback)
HF_TOKEN=
GOOGLE_VISION_API_KEY=

# -----------------------------------------------------------------------------
# Firebase Admin (ONLY used if DB_BACKEND=firebase in a separate deploy env)
# Leave blank when DB_BACKEND=local. NEVER put real production keys in git.
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_JSON=
FIREBASE_STORAGE_BUCKET=
FIREBASE_WEB_API_KEY=
